    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Bsinternet\\Iyzico\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bsinternet\\Iyzico\\IyzicoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
